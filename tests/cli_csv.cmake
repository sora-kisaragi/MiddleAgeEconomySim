file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(scenario balanced shortage oversupply)
  set(path "${OUTPUT_DIR}/${scenario}.csv")
  execute_process(COMMAND "${PROGRAM}" --scenario "${scenario}" --days 3 --csv "${path}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "${scenario} CSV execution failed: ${result} ${error}")
  endif()
  file(STRINGS "${path}" rows)
  list(LENGTH rows count)
  if(NOT count EQUAL 4)
    message(FATAL_ERROR "Expected header and 3 day rows: ${rows}")
  endif()
  list(GET rows 0 header)
  if(NOT header STREQUAL "day,price_index,change_percent,total_money")
    message(FATAL_ERROR "Unexpected CSV header: ${header}")
  endif()
  if(scenario STREQUAL "balanced")
    set(indices 100 100 100)
  elseif(scenario STREQUAL "shortage")
    set(indices 110 120 130)
  else()
    set(indices 90 80 70)
  endif()
  foreach(day RANGE 1 3)
    list(GET rows ${day} row)
    math(EXPR offset "${day}-1")
    list(GET indices ${offset} expected)
    if(NOT row MATCHES "^${day},${expected}([.][0-9]+)?,[-0-9.e+]+,7000$")
      message(FATAL_ERROR "Unexpected ${scenario} row: ${row}")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND "${PROGRAM}" --csv "${OUTPUT_DIR}/absent/file.csv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result STREQUAL "1" OR error STREQUAL "")
  message(FATAL_ERROR "Opening an invalid CSV path must fail")
endif()
set(failed_path "${OUTPUT_DIR}/failed.csv")
execute_process(COMMAND "${FAILURE_PROGRAM}" --csv "${failed_path}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(STRINGS "${failed_path}" rows)
list(LENGTH rows count)
if(NOT result STREQUAL "1" OR NOT count EQUAL 1)
  message(FATAL_ERROR "Interrupted day must not produce a CSV row: ${result} ${rows}")
endif()
