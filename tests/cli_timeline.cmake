file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(run RANGE 1 2)
  execute_process(COMMAND "${PROGRAM}" --scenario balanced --days 3
    --csv "${OUTPUT_DIR}/daily-${run}.csv" --timeline "${OUTPUT_DIR}/trace-${run}.csv"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "timeline execution failed: ${result} ${error}")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/trace-1.csv" first)
file(READ "${OUTPUT_DIR}/trace-2.csv" second)
if(NOT first STREQUAL second)
  message(FATAL_ERROR "same configuration produced different runtime identities/times")
endif()
file(STRINGS "${OUTPUT_DIR}/trace-1.csv" rows)
list(LENGTH rows count)
if(NOT count EQUAL 12 OR NOT first MATCHES "11,DAY_COMPLETED,,3,12,2")
  message(FATAL_ERROR "expected five registered actors and six day boundary events: ${first}")
endif()
execute_process(COMMAND "${FAILURE_PROGRAM}" --scenario balanced --timeline "${OUTPUT_DIR}/failed.csv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${OUTPUT_DIR}/failed.csv" failed)
if(NOT result STREQUAL "1" OR NOT failed MATCHES "DAY_STARTED" OR failed MATCHES "DAY_COMPLETED")
  message(FATAL_ERROR "failed day must have start but no completion: ${failed}")
endif()
execute_process(COMMAND "${PROGRAM}" --timeline "${OUTPUT_DIR}/absent/file.csv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result STREQUAL "1")
  message(FATAL_ERROR "invalid output destination must fail")
endif()
file(WRITE "${OUTPUT_DIR}/preserved.csv" "original data")
execute_process(COMMAND "${PROGRAM}" --csv "${OUTPUT_DIR}/preserved.csv"
  --timeline "${OUTPUT_DIR}/./preserved.csv" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(READ "${OUTPUT_DIR}/preserved.csv" preserved)
if(NOT result STREQUAL "1" OR NOT preserved STREQUAL "original data")
  message(FATAL_ERROR "overlapping destinations must be rejected before truncation")
endif()
